// Eventos do idoso que alimentam o histórico. As doses ficam em DoseEvent e os
// acionamentos do SOS em SosEvent (emergency.prisma).

enum ActivityType {
  ALARM // lembrete disparado no horário de uma dose
}

model ActivityEvent {
  id            Int          @id @default(autoincrement())
  userId        Int          @map("user_id")
  medicationId  Int?         @map("medication_id") // medicamento do alarme
  type          ActivityType
  scheduledTime String?      @map("scheduled_time") // "HH:mm" do lembrete, quando houver
  occurredAt    DateTime     @default(now()) @map("occurred_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId, type, occurredAt])
  @@index([medicationId])
  @@map("activity_event")
}
