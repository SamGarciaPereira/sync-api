# Copie para .env.production e preencha os valores reais.
#   cp .env.production.example .env.production
# Depois suba com:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# ===== Banco da aplicação (MySQL interno) =====
# Estes 4 são lidos pelo compose para criar o container do MySQL.
MYSQL_ROOT_PASSWORD="troque-por-um-segredo"
MYSQL_DATABASE="sync"
MYSQL_USER="sync"
MYSQL_PASSWORD="troque-por-um-segredo"
# A URL deve BATER com os valores acima. Host = nome do serviço "sync-mysql".
DATABASE_URL="mysql://sync:troque-por-um-segredo@sync-mysql:3306/sync"
DATABASE_NAME="sync"

# ===== Porta publicada no host (evita colisão com outro sistema na VPS) =====
# A API é publicada em 127.0.0.1:SYNC_API_PORT (o reverse proxy aponta pra cá).
# Se a 3001 já estiver ocupada, troque por outra (ex.: 3101).
SYNC_API_PORT="3001"

# ===== Sessão / CORS =====
SESSION_SECRET="gere-um-segredo-longo-e-aleatorio"
# URL exata do front na Vercel (com https). Ex.: https://app.seudominio.com
# Dica: se o front ficar num subdomínio do MESMO domínio da API, o cookie de
# login funciona sem mudar código. Se ficar em *.vercel.app (site diferente),
# o cookie precisa virar SameSite=None;Secure em app/models/session.ts.
CORS_ORIGIN="https://app.seudominio.com"

# ===== Web Push (lembretes) =====
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="cole-a-chave-publica"
VAPID_PRIVATE_KEY="cole-a-chave-privada"
VAPID_SUBJECT="mailto:voce@exemplo.com"
# Segredo que o worker usa para acionar o endpoint de disparo
CRON_SECRET="gere-um-segredo-aleatorio"
# URL PÚBLICA da API (vai no payload do push, para o botão "Tomei").
# Ex.: https://api.seudominio.com/api  (o worker usa a interna automaticamente)
PUBLIC_API_URL="https://api.seudominio.com/api"
REMINDER_TZ="America/Sao_Paulo"

# ===== SOS / WhatsApp (Evolution DEDICADA) =====
# Chave da Evolution exclusiva do SYNC (independente da sua outra Evolution).
EVOLUTION_API_KEY="gere-uma-chave-aleatoria"
# Interno: a API fala com a Evolution dedicada pela rede do compose.
EVOLUTION_API_URL="http://sync-evolution:8080"
EVOLUTION_INSTANCE="sync"
# Senha do Postgres da Evolution dedicada.
EVOLUTION_PG_PASSWORD="troque-por-um-segredo"
