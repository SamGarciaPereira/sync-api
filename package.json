{
  "name": "sync-api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up:dev && next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "test": "npm run services:up && concurrently -n next,jest -k -s command-jest \"next dev -p 3001\" \"cross-env NODE_OPTIONS=--experimental-vm-modules jest src/__tests__ --runInBand --forceExit\"",
    "posttest": "npm run services:stop",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll --runInBand",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-database.js",
    "migrations:dev": "dotenv -e .env.development -- prisma migrate dev",
    "migrations:up": "dotenv -e .env -- prisma migrate deploy",
    "migrations:up:dev": "dotenv -e .env.development -- prisma migrate deploy",
    "migrations:reset": "dotenv -e .env.development -- prisma migrate reset",
    "prisma:generate": "dotenv -e .env.development -- prisma generate",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint . --max-warnings 0",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "async-retry": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "dotenv-cli": "^11.0.0",
    "jose": "^6.2.3",
    "mariadb": "^3.5.4",
    "next": "16.2.5",
    "set-cookie-parser": "^3.1.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/async-retry": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/set-cookie-parser": "^2.4.10",
    "commitizen": "^4.3.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.8.3",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
